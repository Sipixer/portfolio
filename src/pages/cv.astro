---
import Base from "../layouts/Base.astro";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-400-italic.css";
import "@fontsource/inter/latin-600.css";
import { profile, job, products, projects, skills, education, languages, strengths } from "../data/profile";

const schoolProjects = projects.filter((p) => p.origin !== "Syloe Group");
---

<Base title={`${profile.name} – CV ${profile.headline}`} noindex skipLink={false}>
  <style is:global>
    @page {
      size: A4;
      margin: 0;
    }
    body {
      color-scheme: light;
    }
    .cv {
      font-family: "Inter", sans-serif;
    }
    @media screen {
      body {
        background: #1e293b;
      }
    }
  </style>
  <div class="cv mx-auto my-8 flex h-[297mm] w-[210mm] overflow-hidden bg-white text-[8.6pt] leading-[1.42] shadow-xl print:my-0 print:shadow-none">
    <aside class="flex w-[64mm] shrink-0 flex-col gap-5 bg-slate-900 px-6 py-8 text-slate-300">
      <div>
        <h1 class="text-[19pt] leading-tight font-semibold text-white">{profile.name}</h1>
        <p class="mt-1.5 text-[9.5pt] leading-snug text-sky-300">{profile.headline}</p>
      </div>

      <section>
        <h2 class="cv-side-title">Contact</h2>
        <ul class="space-y-1">
          <li>{profile.locationFull}</li>
          <li>{profile.phone}</li>
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={`https://www.${profile.site}`}>{profile.site}</a></li>
          <li><a href={profile.github}>{profile.githubLabel}</a></li>
          <li>{profile.driving}</li>
        </ul>
      </section>

      <section>
        <h2 class="cv-side-title">Compétences</h2>
        <div class="space-y-2.5">
          {
            skills.map((s) => (
              <div>
                <p class="font-semibold text-white">{s.group}</p>
                <p>
                  {s.items.map((item, i) => (
                    <>
                      <span class="whitespace-nowrap">{item}{i < s.items.length - 1 ? "," : ""}</span>{" "}
                    </>
                  ))}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="cv-side-title">Langues</h2>
        <ul class="space-y-1">
          {languages.map((l) => <li><span class="font-semibold text-white">{l.name}</span>&nbsp;: {l.level}</li>)}
        </ul>
      </section>

      <section>
        <h2 class="cv-side-title">Atouts</h2>
        <ul class="space-y-1">{strengths.map((c) => <li>{c}</li>)}</ul>
      </section>
    </aside>

    <main class="flex flex-1 flex-col gap-3.5 px-7 py-8 text-slate-700">
      <section>
        <h2 class="cv-title">Profil</h2>
        <p class="text-[9pt] text-slate-600">{profile.summary}</p>
      </section>

      <section>
        <h2 class="cv-title">Expérience professionnelle</h2>
        <h3 class="font-semibold text-slate-900">{job.role}</h3>
        <p><span class="font-semibold text-sky-700">{job.org}</span> <span class="text-slate-500">| {job.period}</span></p>
        <p class="text-slate-500 italic">{job.orgContext[0].toUpperCase() + job.orgContext.slice(1)}. {job.note}</p>
        <div class="mt-2 space-y-2">
          {
            products.map((pr) => (
              <div>
                <p>
                  <span class="font-semibold text-slate-900">{pr.name}</span>&nbsp;: {pr.summary} <span class="text-slate-500">({pr.period})</span>
                </p>
                <ul class="mt-0.5 space-y-0.5">
                  {pr.points.map((pt) => <li class="cv-bullet">{pt}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="cv-title">Projets</h2>
        <div class="space-y-1">
          {
            schoolProjects.map((p) => (
              <p>
                <span class="font-semibold text-slate-900">{p.name}</span> <span class="text-slate-500">(Ynov)</span>&nbsp;: {p.description}
              </p>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="cv-title">Formation</h2>
        <div class="space-y-1.5">
          {
            education.map((e) => (
              <div>
                <h3 class="font-semibold text-slate-900">
                  {e.title} <span class="font-normal text-slate-500">| {e.period}</span>
                </h3>
                <p>
                  {e.school}
                  {e.detail && <span class="text-slate-500"> · {e.detail}</span>}
                </p>
              </div>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</Base>

<style>
  @reference "../styles/global.css";
  .cv :global(.cv-title) {
    @apply mb-1.5 border-b border-slate-200 pb-1 text-[8pt] font-semibold tracking-[0.02em] text-sky-700 uppercase;
  }
  .cv :global(.cv-side-title) {
    @apply mb-1.5 text-[8pt] font-semibold tracking-[0.02em] text-sky-300 uppercase;
  }
  .cv :global(.cv-bullet) {
    padding-left: 0.9em;
    text-indent: -0.9em;
  }
  .cv :global(.cv-bullet)::before {
    content: "•\00a0\00a0";
    color: var(--color-slate-400);
  }
</style>
