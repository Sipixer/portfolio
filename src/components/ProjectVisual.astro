---
import { Image } from "astro:assets";
import tribushare from "../assets/shots/tribushare.png";
import type { Lang, Visual } from "../data/profile";

interface Props {
  visual: Visual;
  lang: Lang;
  screenshotAlt: string;
}

const { visual, lang, screenshotAlt } = Astro.props;
const labels = {
  fr: {
    encoderDone: "✓ audio · vignettes · publié sur R2",
    missionsTitle: "Missions de la semaine",
    missions: ["Regarder l’épisode 3", "Inviter deux amis", "Voter pour la suite"],
    play: "▶ lecture",
    lanterna: "déchiffré en mémoire · rien d’écrit sur le disque",
    spire: ["front", "panier", "paiement", "stats"],
    spireNote: "spiffe://boutique · mTLS partout",
    jobs: "2 terminées · 2 en cours · 1 relancée · 3 en attente",
    server: "serveur",
    rps: "requêtes / s",
  },
  en: {
    encoderDone: "✓ audio · thumbnails · published to R2",
    missionsTitle: "This week’s missions",
    missions: ["Watch episode 3", "Invite two friends", "Vote for what’s next"],
    play: "▶ play",
    lanterna: "decrypted in memory · nothing written to disk",
    spire: ["front", "cart", "payment", "stats"],
    spireNote: "spiffe://shop · mTLS everywhere",
    jobs: "2 done · 2 running · 1 retried · 3 queued",
    server: "server",
    rps: "requests / s",
  },
}[lang];
const ladder = [
  { label: "1080p", width: "100%" },
  { label: "720p", width: "74%" },
  { label: "480p", width: "52%" },
  { label: "360p", width: "36%" },
];
const missions = [
  { label: labels.missions[0], progress: "100%", reward: "+50" },
  { label: labels.missions[1], progress: "50%", reward: "+120" },
  { label: labels.missions[2], progress: "15%", reward: "+30" },
];
const services = labels.spire;
const jobs = ["done", "done", "run", "run", "retry", "wait", "wait", "wait"];
const spark = [12, 18, 14, 22, 19, 28, 24, 31, 26, 35, 30, 42, 37, 33, 40];
const sparkPath = spark.map((v, i) => `${i === 0 ? "M" : "L"}${(i / (spark.length - 1)) * 300},${60 - v}`).join(" ");
const dark = "flex h-full w-full flex-col justify-center rounded-2xl bg-stone-900 p-5 font-mono text-[11px] text-white/70";
const light = "flex h-full w-full flex-col justify-center rounded-2xl bg-stone-100 p-5 font-mono text-[11px] text-stone-600";
---

{
  visual === "tribushare" && (
    <div class="flex h-full flex-col overflow-hidden rounded-t-xl border border-b-0 border-stone-900/10 bg-stone-900 shadow-[0_20px_50px_-20px_rgba(28,25,23,0.45)]">
      <div class="flex items-center gap-1.5 px-3 py-2" aria-hidden="true">
        <span class="size-2 rounded-full bg-white/25" />
        <span class="size-2 rounded-full bg-white/25" />
        <span class="size-2 rounded-full bg-white/25" />
        <span class="ml-3 rounded bg-white/10 px-2 py-0.5 font-mono text-[10px] text-white/60">tribushare.com</span>
      </div>
      <Image src={tribushare} alt={screenshotAlt} widths={[640, 1080, 1600]} sizes="(min-width: 1024px) 760px, 100vw" class="block aspect-[16/9] w-full object-cover object-left-top lg:aspect-auto lg:min-h-0 lg:flex-1" loading="lazy" />
    </div>
  )
}

{
  visual === "encoder" && (
    <div class:list={[dark, "gap-2.5"]} aria-hidden="true">
      <p class="text-white/45">film.mov → stream.m3u8</p>
      {ladder.map((r) => (
        <div class="flex items-center gap-3">
          <span class="w-11 text-right">{r.label}</span>
          <div class="h-3 flex-1">
            <div class="flex h-full gap-[3px]" style={`width:${r.width}`}>
              {Array.from({ length: 10 }).map(() => <span class="h-full flex-1 rounded-[2px] bg-gradient-to-b from-orange-400 to-orange-600" />)}
            </div>
          </div>
        </div>
      ))}
      <p class="pt-1 text-emerald-300">{labels.encoderDone}</p>
    </div>
  )
}

{
  visual === "tribiew" && (
    <div class:list={[dark, "gap-2 font-sans ring-1 ring-violet-400/30 ring-inset"]} aria-hidden="true">
      <p class="text-[11px] font-semibold tracking-wide text-violet-300 uppercase">{labels.missionsTitle}</p>
      {missions.map((m) => (
        <div class="rounded-lg bg-white/[0.06] px-3 py-1.5">
          <div class="flex justify-between text-[12px] font-medium text-white/85">
            <span>{m.label}</span>
            <span class="font-mono text-violet-300">{m.reward}</span>
          </div>
          <div class="mt-1.5 h-1 rounded-full bg-white/10">
            <div class="h-full rounded-full bg-violet-400" style={`width:${m.progress}`} />
          </div>
        </div>
      ))}
    </div>
  )
}

{
  visual === "lanterna" && (
    <div class:list={[dark, "gap-4"]} aria-hidden="true">
      <div class="flex items-center gap-2">
        <span class="rounded-lg bg-white/10 px-3 py-2 whitespace-nowrap">film.enc</span>
        <span class="h-px flex-1 border-t border-dashed border-white/30" />
        <svg viewBox="0 0 16 16" class="size-6 shrink-0 text-amber-300" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="7" width="10" height="7" rx="1.5" /><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" /></svg>
        <span class="h-px flex-1 border-t border-dashed border-white/30" />
        <span class="rounded-lg bg-amber-300 px-3 py-2 font-semibold whitespace-nowrap text-stone-900">{labels.play}</span>
      </div>
      <p class="text-center text-white/45">{labels.lanterna}</p>
    </div>
  )
}

{
  visual === "spire" && (
    <div class:list={[light, "gap-3"]} aria-hidden="true">
      <div class="grid grid-cols-2 gap-2.5">
        {services.map((s) => (
          <div class="flex items-center gap-2 rounded-lg border border-stone-200 bg-white px-3 py-2 shadow-[0_1px_2px_rgba(28,25,23,0.05)]">
            <svg viewBox="0 0 16 16" class="size-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="7" width="10" height="7" rx="1.5" /><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" /></svg>
            {s}
          </div>
        ))}
      </div>
      <p class="text-center text-[10px] text-stone-500">{labels.spireNote}</p>
    </div>
  )
}

{
  visual === "frameforge" && (
    <div class:list={[light, "gap-3"]} aria-hidden="true">
      <div class="grid grid-cols-8 gap-1.5">
        {jobs.map((j) => (
          <span
            class:list={[
              "aspect-square rounded-md",
              j === "done" && "bg-emerald-500",
              j === "run" && "animate-pulse bg-orange-500 motion-reduce:animate-none",
              j === "retry" && "bg-amber-300",
              j === "wait" && "bg-stone-300",
            ]}
          />
        ))}
      </div>
      <p class="text-[10px] text-stone-500">{labels.jobs}</p>
    </div>
  )
}

{
  visual === "chat" && (
    <div class={light} aria-hidden="true">
      <div class="flex items-center gap-2">
        <span class="rounded-lg border border-stone-200 bg-white px-3 py-2 whitespace-nowrap">{labels.server} A</span>
        <span class="h-px flex-1 border-t border-dashed border-stone-400" />
        <span class="rounded-lg bg-[#D82C20] px-3 py-2 font-semibold text-white">Redis</span>
        <span class="h-px flex-1 border-t border-dashed border-stone-400" />
        <span class="rounded-lg border border-stone-200 bg-white px-3 py-2 whitespace-nowrap">{labels.server} B</span>
      </div>
    </div>
  )
}

{
  visual === "observability" && (
    <div class={light} aria-hidden="true">
      <div class="flex justify-between text-[10px] text-stone-500">
        <span>{labels.rps}</span>
        <span class="text-emerald-700">p95 120 ms</span>
      </div>
      <svg viewBox="0 0 300 60" class="mt-2 h-16 w-full" preserveAspectRatio="none">
        <defs>
          <linearGradient id="spark" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="#e8590c" stop-opacity="0.3" />
            <stop offset="1" stop-color="#e8590c" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path d={`${sparkPath} L300,60 L0,60 Z`} fill="url(#spark)" />
        <path d={sparkPath} fill="none" stroke="#e8590c" stroke-width="2" vector-effect="non-scaling-stroke" />
      </svg>
    </div>
  )
}
