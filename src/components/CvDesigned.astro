---
import Base from "../layouts/Base.astro";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-400-italic.css";
import "@fontsource/inter/latin-600.css";
import { contact, content, projectsFor, type Lang } from "../data/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = content[lang];
const t = c.ui.cv;
const schoolProjects = projectsFor(lang).filter((p) => p.origin === "school");
---

<Base lang={lang} title={`${contact.name} – ${t.title} ${c.headline}`} noindex skipLink={false}>
  <style is:global>
    @page {
      size: A4;
      margin: 0;
    }
    body {
      color-scheme: light;
    }
    .cv {
      font-family: "Inter", sans-serif;
    }
    @media screen {
      body {
        background: #1e293b;
      }
    }
  </style>
  <div class="cv mx-auto my-8 flex h-[297mm] w-[210mm] overflow-hidden bg-white text-[9.7pt] leading-[1.5] shadow-xl print:my-0 print:shadow-none">
    <aside class="flex w-[62mm] shrink-0 flex-col gap-6 bg-slate-900 px-6 py-9 text-slate-300">
      <div>
        <h1 class="text-[20pt] leading-tight font-semibold text-white">{contact.name}</h1>
        <p class="mt-2 text-[10pt] leading-snug text-sky-300">{c.headline}</p>
      </div>

      <section>
        <h2 class="cv-side-title">{t.contact}</h2>
        <ul class="space-y-1">
          <li>{c.locationFull}</li>
          <li>{contact.phone}</li>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a href={contact.siteUrl}>{contact.site}</a></li>
          <li><a href={contact.github}>{contact.githubLabel}</a></li>
          <li>{c.driving}</li>
        </ul>
      </section>

      <section>
        <h2 class="cv-side-title">{t.skills}</h2>
        <div class="space-y-3">
          {
            c.skills.map((s) => (
              <div>
                <p class="font-semibold text-white">{s.group}</p>
                <p>
                  {s.items.map((item, i) => (
                    <>
                      <span class="whitespace-nowrap">{item}{i < s.items.length - 1 ? "," : ""}</span>{" "}
                    </>
                  ))}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="cv-side-title">{t.languages}</h2>
        <ul class="space-y-1">
          {c.languages.map((l) => <li><span class="font-semibold text-white">{l.name}</span>{lang === "fr" ? " :" : ":"} {l.level}</li>)}
        </ul>
      </section>

    </aside>

    <main class="flex flex-1 flex-col gap-6 px-8 py-10 text-slate-700">
      <section>
        <h2 class="cv-title">{t.profile}</h2>
        <p class="text-[10.2pt] leading-[1.5] text-slate-700">{c.summary}</p>
      </section>

      <section>
        <h2 class="cv-title">{t.experience}</h2>
        <h3 class="text-[10.8pt] font-semibold text-slate-900">{c.job.role}</h3>
        <p><span class="font-semibold text-sky-700">{c.job.org}</span> <span class="text-slate-500">| {c.job.period}</span></p>
        <p class="text-slate-500">{c.job.note}</p>
        <div class="mt-3 space-y-3">
          {
            c.products.map((pr) => (
              <div>
                <p>
                  <span class="font-semibold text-slate-900">{pr.name}</span> <span class="text-slate-500">({pr.period})</span> – {pr.summary}
                </p>
                <ul class="mt-1 space-y-0.5">
                  {pr.points.map((pt) => <li class="cv-bullet">{pt}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="cv-title">{t.projects} ({t.schoolTag})</h2>
        <ul class="space-y-1">
          {
            schoolProjects.map((p) => (
              <li class="cv-bullet">
                <span class="font-semibold text-slate-900">{p.name}</span> – {p.tagline} <span class="text-slate-500">({p.tags.join(", ")})</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 class="cv-title">{t.education}</h2>
        <div class="space-y-1.5">
          {
            c.education.map((e) => (
              <div>
                <h3 class="font-semibold text-slate-900">
                  {e.title} <span class="font-normal text-slate-500">| {e.period}</span>
                </h3>
                <p class="text-slate-600">
                  {e.school}{e.detail && ` · ${e.detail}`}
                </p>
              </div>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</Base>

<style>
  @reference "../styles/global.css";
  .cv :global(.cv-title) {
    @apply mb-2 border-b border-slate-200 pb-1 text-[9pt] font-semibold tracking-[0.02em] text-sky-700 uppercase;
  }
  .cv :global(.cv-side-title) {
    @apply mb-2 text-[9pt] font-semibold tracking-[0.02em] text-sky-300 uppercase;
  }
  .cv :global(.cv-bullet) {
    padding-left: 0.9em;
    text-indent: -0.9em;
  }
  .cv :global(.cv-bullet)::before {
    content: "•\00a0\00a0";
    color: var(--color-slate-400);
  }
</style>
